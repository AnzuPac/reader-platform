# Основное
POSTGRES_PASSWORD=replace-with-long-random-password
SITE_URL=https://example.com
JWT_SECRET=change-me-to-a-long-random-string-32chars
ADMIN_TOKEN=change-me-admin-token

# База данных: если задан DATABASE_URL — используется PostgreSQL, иначе SQLite (локально)
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/reader

# Stripe (без ключа покупки и донаты идут в ручной режим подтверждения)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_READER=price_...
# STRIPE_PRICE_READER_PLUS=price_...

# Переводы (локальная модель)
OLLAMA_URL=http://127.0.0.1:11434
TRANSLATE_MODEL=qwen2.5:7b

# Донаты: доля площадки в процентах (по умолчанию 10)
# DONATION_FEE_PCT=10

# Локальная SQLite-папка (по умолчанию ./data)
# SQLITE_DIR=/var/lib/reader

# Почта (напоминания о продлении). Без ключа письма не отправляются, но факт не портится.
RESEND_API_KEY=
MAIL_FROM=Citaonica <no-reply@example.com>

# Регистрация и защита
SITE_URL=https://terolibrary.com
# Cloudflare Turnstile: без секрета защита выключена; TURNSTILE_ENFORCE=1
# заставляет требовать проверку даже без ключа (тогда регистрация вернёт 503).
TURNSTILE_ENFORCE=0
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Почта (Resend). Без ключа письма не отправляются, ссылка печатается в лог в dev.
RESEND_API_KEY=
MAIL_FROM=TeroLibrary <no-reply@terolibrary.com>
