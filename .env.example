# Основное
SITE_URL=https://example.com
JWT_SECRET=change-me-to-a-long-random-string-32chars
ADMIN_TOKEN=change-me-admin-token

# База данных: если задан DATABASE_URL — используется PostgreSQL, иначе SQLite (локально)
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/reader

# Stripe (без ключа покупки и донаты идут в ручной режим подтверждения)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_READER=price_...
# STRIPE_PRICE_READER_PLUS=price_...

# Переводы (локальная модель)
OLLAMA_URL=http://127.0.0.1:11434
TRANSLATE_MODEL=qwen2.5:7b

# Донаты: доля площадки в процентах (по умолчанию 10)
# DONATION_FEE_PCT=10

# Локальная SQLite-папка (по умолчанию ./data)
# SQLITE_DIR=/var/lib/reader
